{
  "info": {
    "_postman_id": "9f6c4b2e-3a1d-4e8c-b5a7-1d2f3a4b5c6d",
    "name": "SOMS 客户服务接口测试",
    "description": "客户管理 CRUD + 会员账户（余额/积分/等级/状态）+ 内部接口（Feign 契约）。直连 service-customer（8010）。\n\n使用说明：\n1. 环境变量 baseUrl 默认 http://127.0.0.1:8010，如经网关请改为 http://127.0.0.1:80。\n2. 先执行「新增客户」，会自动把返回的 customerId 存入集合变量，后续接口自动使用。\n3. 也可手动在集合变量中修改 customerId。\n4. 内部接口按契约仅供服务间调用，测试时直连即可。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-客户管理（CRUD）",
      "item": [
        {
          "name": "新增客户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.code === 0 && json.data && json.data.customerId) {",
                  "    pm.collectionVariables.set(\"customerId\", json.data.customerId);",
                  "    console.log(\"customerId 已设置为: \" + json.data.customerId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"张三\",\n  \"mobile\": \"13800138000\",\n  \"customerLevel\": 1,\n  \"balance\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "分页查询客户列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/list?pageNum=1&pageSize=10&customerName=张",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "list"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "customerName",
                  "value": "张"
                }
              ]
            }
          }
        },
        {
          "name": "按ID查询客户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "按手机号查询客户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/mobile/13800138000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "mobile",
                "13800138000"
              ]
            }
          }
        },
        {
          "name": "修改客户（部分字段）",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"customerName\": \"张三（已更新）\",\n  \"customerLevel\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "删除客户（逻辑删除）",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02-会员账户（余额/积分/等级/状态）",
      "item": [
        {
          "name": "账户概览",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}",
                "account"
              ]
            }
          }
        },
        {
          "name": "余额充值",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}/recharge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}",
                "recharge"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.00,\n  \"bizId\": \"PAY20260922001\",\n  \"remark\": \"微信充值\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "余额流水",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}/balance-logs?pageNum=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}",
                "balance-logs"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "积分流水",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}/points-logs?pageNum=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}",
                "points-logs"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "启用/禁用会员",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/{{customerId}}/status?status=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "{{customerId}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "1",
                  "description": "0禁用，1正常"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03-内部接口（Feign 契约）",
      "item": [
        {
          "name": "批量查询会员",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/internal/batch?customerIds=1,2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "internal",
                "batch"
              ],
              "query": [
                {
                  "key": "customerIds",
                  "value": "1,2"
                }
              ]
            }
          }
        },
        {
          "name": "余额扣减（幂等）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/internal/balance/deduct",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "internal",
                "balance",
                "deduct"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"amount\": 50.00,\n  \"bizType\": \"ORDER\",\n  \"bizId\": \"SO20260922001001\",\n  \"remark\": \"订单支付\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "消费完成回调（幂等）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/internal/consume/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "internal",
                "consume",
                "complete"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"consumeAmount\": 2000.00,\n  \"bizType\": \"ORDER\",\n  \"bizId\": \"SO20260922001001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8010",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    }
  ]
}
